# ================= NPA TRACKING BOT =================
# Copy file này thành .env rồi điền giá trị:   cp .env.example .env

# (BẮT BUỘC) Token bot Telegram — lấy từ @BotFather bằng lệnh /newbot
# Lưu ý: phải là bot riêng, không dùng chung token với bot khác đang chạy!
BOT_TOKEN=

# Bao nhiêu phút check ngầm 1 lần (khuyến nghị 3–5, đừng để dưới 2 kẻo bị hãng chặn IP)
CHECK_INTERVAL_MINUTES=3

# Khoá bot chỉ cho các Chat ID này (cách nhau dấu phẩy). Để trống = ai cũng dùng được.
# Lấy Chat ID: nhắn /id cho bot.
ALLOWED_CHAT_IDS=

# File lưu danh sách mã (không cần đổi)
DATA_FILE=data.json
